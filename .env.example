# Copia este archivo a .env y pon tus valores. Aquí solo van nombres y valores FALSOS.
# Comprueba que quedó bien con: npx tsx scripts/probar-conexion.ts

# --- Supabase Storage (imágenes y Excel; solo servidor, nunca NEXT_PUBLIC_)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=valor-falso
SUPABASE_BUCKET_FACTURAS=facturas

# --- Firebase, app web (públicas por diseño)
NEXT_PUBLIC_FIREBASE_API_KEY=valor-falso
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:valorfalso

# --- Firebase, cuenta de servicio (solo servidor, nunca NEXT_PUBLIC_)
FIREBASE_ADMIN_PROJECT_ID=tu-proyecto
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Saltos de línea escritos como \n y entre comillas dobles.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVALOR_FALSO\n-----END PRIVATE KEY-----\n"

# --- Autorización: correos separados por comas
USUARIOS_PERMITIDOS=correo@ejemplo.com
